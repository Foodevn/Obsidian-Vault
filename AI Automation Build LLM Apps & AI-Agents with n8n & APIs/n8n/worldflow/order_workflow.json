                "bodyParametersJson": "={ { \n  \"recipient\": { \"user_id\": $json.userId },\n  \"message\": { \"text\": 'Đơn hàng của bạn đã được ghi nhận! Shop sẽ xác nhận sớm.' }\n} }"
