        },
        {
            "parameters": {
                "functionCode": "// Validate payload\nconst { userId, product, size, quantity } = $json;\nif(!product) { return [{ json: { error: 'Missing product' }}]; }\nreturn [{ json: { userId, product, size, quantity: quantity || 1 }}];"
            },
            "type": "n8n-nodes-base.function",
            "typeVersion": 1,
            "position": [
                -760,
                80
            ],
            "id": "4a2ee9a8-00d8-4e71-9e1f-09c3b357d8f9",
            "name": "Validate"
        },
        {
            "parameters": {
                "functionCode": "// Giả lập tồn kho - sau thay bằng DB\nconst stock = { 'Áo sơ mi trắng': { 'S': 5, 'M': 2, 'L': 0 } };\nconst { product, size, quantity } = $json;\nlet available = false;\nif (stock[product] && stock[product][size] >= quantity) available = true;\nreturn [{ json: { ...$json, available }}];"
            },
            "type": "n8n-nodes-base.function",
            "typeVersion": 1,
            "position": [
                -540,
                80
            ],
            "id": "d9dd2762-8f8d-4d4e-9ed1-8a0d5141bcd2",
            "name": "Check Stock"
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [],
                    "string": [],
                    "number": [],
                    "collection": [
                        {
                            "value1": "={{$json.available}}",
                            "operation": "equal",
                            "value2": true
                        }
                    ]
                }
            },
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                -320,
                80
            ],
            "id": "a821f2fa-037a-49e3-9c45-90dbfa1c7cc3",
            "name": "In Stock?"
        },
        {
            "parameters": {
                "url": "https://partner.shopeemobile.com/api/v2/order/create",
                "method": "POST",
                "jsonParameters": true,
                "bodyParametersJson": "={ { \n  \"product_name\": $json.product,\n  \"size\": $json.size,\n  \"quantity\": $json.quantity,\n  \"customer_id\": $json.userId \n} }"
            },
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 1,
            "position": [
                -80,
                0
            ],
            "id": "9e1c3d2a-f9b3-48b7-bee8-1d28dfc6a341",
            "name": "Create Shopee Order"
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO orders (customer_id, product, size, quantity, status) VALUES ({{$json.userId}}, '{{$json.product}}', '{{$json.size}}', {{$json.quantity}}, 'pending');"
            },
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
